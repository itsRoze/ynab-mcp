{
  "name": "ynab-conversation-mcp",
  "version": "0.1.0",
  "description": "YNAB MCP server for conversational budgeting with Claude and Codex, locally or on Cloudflare",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ynab-conversation-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit",
    "prepack": "pnpm run build",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "config": "node scripts/config.mjs",
    "check:worker": "tsc -p tsconfig.worker.json",
    "test:remote": "node scripts/test-remote.mjs",
    "deploy": "node scripts/deploy.mjs",
    "remote:password": "node scripts/remote-password.mjs",
    "connect:codex": "node scripts/connect-codex.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.136.3"
  },
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsRoze/ynab-mcp.git"
  },
  "homepage": "https://github.com/itsRoze/ynab-mcp#readme",
  "bugs": {
    "url": "https://github.com/itsRoze/ynab-mcp/issues"
  }
}
